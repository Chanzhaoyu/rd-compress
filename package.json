{
  "name": "rd-compress",
  "private": true,
  "version": "0.1.0",
  "description": "内部图片/视频在线压缩工具站 - 前端 Vite+React + 后端 Hono",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:server": "pnpm --filter @rd-compress/server dev",
    "dev:web": "pnpm --filter @rd-compress/web dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @rd-compress/server build",
    "build:web": "pnpm --filter @rd-compress/web build",
    "lint": "pnpm -r lint"
  }
}
