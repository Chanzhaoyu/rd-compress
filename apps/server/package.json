{
  "name": "@redon-compress/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "download:ffmpeg": "node scripts/download-ffmpeg.mjs",
    "download:ffmpeg:win": "node scripts/download-ffmpeg.mjs --win",
    "download:ffmpeg:all": "node scripts/download-ffmpeg.mjs --all",
    "postinstall": "node scripts/download-ffmpeg.mjs || true",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:logs": "pm2 logs redon-compress-server",
    "pm2:delete": "pm2 delete ecosystem.config.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "hono": "^4.5.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
